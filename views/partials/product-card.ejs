<%
const isAvailable = product.stock > 0;
const badgeLabel = isAvailable ? `Stok: ${product.stock}` : 'Habis';
const badgeColor = isAvailable ? 'green' : 'red';
const categoryIcons = {
  'Kaos': '👕', 'Kemeja': '👔', 'Celana': '👖', 'Sepatu': '👟',
  'Aksesoris': '⌚', 'Jaket': '🧥', 'Tas': '👜', 'Umum': '📦',
};
const icon = categoryIcons[product.category] || '📦';
%>
<div class="group bg-white border border-gray-100 rounded-2xl overflow-hidden shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300">
  <!-- Image/Icon area -->
  <div class="h-40 bg-gradient-to-br from-slate-50 to-slate-100 flex items-center justify-center relative overflow-hidden">
    <span class="text-6xl group-hover:scale-110 transition-transform duration-300"><%= icon %></span>
    <div class="absolute top-3 left-3">
      <span class="inline-block px-2.5 py-1 text-xs font-semibold rounded-full bg-white/80 backdrop-blur text-slate-600 border border-slate-200/50 shadow-sm">
        <%= product.category || 'Umum' %>
      </span>
    </div>
    <div class="absolute top-3 right-3">
      <%- include('badge', { label: badgeLabel, color: badgeColor }) %>
    </div>
  </div>

  <div class="p-4">
    <h3 class="font-bold text-gray-800 text-base mb-1 group-hover:text-blue-600 transition-colors"><%= product.name %></h3>
    <p class="text-sm text-gray-400 mb-3 line-clamp-2 leading-relaxed"><%= product.description || 'Tanpa deskripsi' %></p>

    <div class="flex items-center justify-between">
      <p class="text-lg font-extrabold bg-gradient-to-r from-blue-600 to-purple-600 bg-clip-text text-transparent">
        Rp<%= product.price.toLocaleString('id-ID') %>
      </p>

      <% if (isAvailable) { %>
        <button
          onclick="addToCart({id: <%= product.id %>, name: '<%= product.name.replace(/'/g, "\\'") %>', price: <%= product.price %>, stock: <%= product.stock %>, category: '<%= product.category || 'Umum' %>'})"
          class="px-4 py-2 bg-gradient-to-r from-blue-500 to-purple-600 hover:from-blue-600 hover:to-purple-700 text-white text-sm font-semibold rounded-xl transition-all duration-200 shadow-md shadow-blue-500/20 hover:shadow-blue-500/40 hover:-translate-y-0.5 active:translate-y-0 flex items-center gap-1.5">
          <span>🛒</span> Tambah
        </button>
      <% } else { %>
        <button disabled class="px-4 py-2 bg-gray-100 text-gray-400 text-sm font-semibold rounded-xl cursor-not-allowed">
          Habis
        </button>
      <% } %>
    </div>
  </div>
</div>
