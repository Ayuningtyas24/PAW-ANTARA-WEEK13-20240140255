<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Invoice Detail — <%= storeName %></title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>body { font-family: 'Inter', sans-serif; }</style>
</head>
<body class="bg-gray-50 min-h-screen">
  <%- include('partials/nav', { storeName, active: 'invoice' }) %>
  <%- include('partials/status-helper') %>

  <main class="max-w-2xl mx-auto px-4 pb-10">
    <a href="javascript:history.back()" class="inline-flex items-center gap-1 text-sm text-gray-400 hover:text-gray-600 mb-6 transition-colors">
      ← Kembali
    </a>

    <div class="bg-white border border-gray-200 rounded-2xl overflow-hidden shadow-sm">
      <div class="bg-gradient-to-r from-slate-800 to-slate-900 px-6 py-5 flex items-center justify-between">
        <div>
          <h1 class="text-xl font-bold text-white">INV-<%= String(order.id).padStart(5, '0') %></h1>
          <p class="text-sm text-slate-400 mt-0.5">
            <%= new Date(order.createdAt).toLocaleString('id-ID', { dateStyle: 'long', timeStyle: 'short' }) %>
          </p>
        </div>
        <span data-badge><%- include('partials/badge', { label: order.status, color: getStatusColor(order.status) }) %></span>
      </div>

      <div class="p-6">
        <div class="grid grid-cols-2 gap-4 mb-6 text-sm">
          <div>
            <p class="text-gray-400 text-xs uppercase tracking-wider mb-1">Pembeli</p>
            <p class="font-semibold text-gray-800"><%= order.buyerName %></p>
          </div>
          <div>
            <p class="text-gray-400 text-xs uppercase tracking-wider mb-1">Akun</p>
            <p class="font-semibold text-gray-800"><%= order.User ? order.User.fullName : '-' %></p>
          </div>
        </div>

        <h3 class="text-sm font-bold text-gray-800 mb-3 uppercase tracking-wider">Detail Produk</h3>
        <div class="border border-gray-200 rounded-xl overflow-hidden mb-6">
          <table class="w-full text-sm">
            <thead class="bg-gray-50">
              <tr>
                <th class="text-left px-4 py-2.5 text-gray-500 font-medium">Produk</th>
                <th class="text-center px-4 py-2.5 text-gray-500 font-medium">Qty</th>
                <th class="text-right px-4 py-2.5 text-gray-500 font-medium">Harga</th>
                <th class="text-right px-4 py-2.5 text-gray-500 font-medium">Subtotal</th>
              </tr>
            </thead>
            <tbody>
              <% if (order.OrderItems) { %>
                <% order.OrderItems.forEach(function(item) { %>
                  <tr class="border-t border-gray-100">
                    <td class="px-4 py-3 font-medium text-gray-800"><%= item.Product ? item.Product.name : '(dihapus)' %></td>
                    <td class="px-4 py-3 text-center text-gray-600"><%= item.quantity %></td>
                    <td class="px-4 py-3 text-right text-gray-600">Rp<%= item.price.toLocaleString('id-ID') %></td>
                    <td class="px-4 py-3 text-right font-semibold text-gray-800">Rp<%= (item.price * item.quantity).toLocaleString('id-ID') %></td>
                  </tr>
                <% }); %>
              <% } %>
            </tbody>
          </table>
        </div>

        <div class="flex items-center justify-end gap-4 py-3 border-t border-gray-200">
          <span class="text-gray-600 font-medium">Total Pembayaran</span>
          <span class="text-2xl font-extrabold bg-gradient-to-r from-blue-600 to-purple-600 bg-clip-text text-transparent">
            Rp<%= order.totalAmount.toLocaleString('id-ID') %>
          </span>
        </div>

        <% if (typeof user !== 'undefined' && user && user.role === 'admin') { %>
          <div class="mt-4 pt-4 border-t border-gray-200">
            <label class="block text-sm font-bold text-gray-800 mb-2 uppercase tracking-wider">Ubah Status Pesanan</label>
            <div class="flex items-center gap-3">
              <select
                id="status-select"
                class="flex-1 px-4 py-2.5 border border-gray-200 rounded-xl text-sm bg-white focus:outline-none focus:ring-2 focus:ring-blue-400/50 font-medium">
                <option value="pending" <%= order.status === 'pending' ? 'selected' : '' %>>Pending</option>
                <option value="diproses" <%= order.status === 'diproses' ? 'selected' : '' %>>Diproses</option>
                <option value="dikirim" <%= order.status === 'dikirim' ? 'selected' : '' %>>Dikirim</option>
                <option value="selesai" <%= order.status === 'selesai' ? 'selected' : '' %>>Selesai</option>
                <option value="dibatalkan" <%= order.status === 'dibatalkan' ? 'selected' : '' %>>Dibatalkan</option>
              </select>
              <button
                id="update-status-btn"
                onclick="updateStatus()"
                class="px-5 py-2.5 bg-gradient-to-r from-blue-500 to-purple-600 hover:from-blue-600 hover:to-purple-700 text-white text-sm font-semibold rounded-xl transition-all duration-200 shadow-lg shadow-blue-500/25 hover:shadow-blue-500/40">
                Simpan
              </button>
            </div>
            <p id="status-feedback" class="text-sm mt-2 hidden"></p>
          </div>
        <% } %>
      </div>
    </div>
  </main>

  <% if (typeof user !== 'undefined' && user && user.role === 'admin') { %>
  <script>
    const statusColorMap = {
      pending: 'yellow',
      diproses: 'blue',
      dikirim: 'purple',
      selesai: 'green',
      dibatalkan: 'red',
    };
    const colorClasses = {
      green: 'bg-emerald-100 text-emerald-700 border-emerald-300',
      red: 'bg-red-100 text-red-700 border-red-300',
      yellow: 'bg-amber-100 text-amber-700 border-amber-300',
      blue: 'bg-blue-100 text-blue-700 border-blue-300',
      purple: 'bg-purple-100 text-purple-700 border-purple-300',
      gray: 'bg-gray-100 text-gray-700 border-gray-300',
    };

    async function updateStatus() {
      const select = document.getElementById('status-select');
      const feedback = document.getElementById('status-feedback');
      const btn = document.getElementById('update-status-btn');
      const status = select.value;

      btn.disabled = true;
      btn.textContent = 'Menyimpan...';

      try {
        const res = await fetch('/api/orders/<%= order.id %>/status', {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ status }),
        });

        const result = await res.json();

        if (!result.success) {
          feedback.textContent = '❌ ' + result.message;
          feedback.className = 'text-sm mt-2 text-red-500';
          feedback.classList.remove('hidden');
          return;
        }

        // Update badge di header
        const badgeContainer = document.querySelector('[data-badge]');
        if (badgeContainer) {
          const color = statusColorMap[status] || 'gray';
          badgeContainer.innerHTML = `<span class="inline-block px-2.5 py-1 text-xs font-bold rounded-full border ${colorClasses[color]}">${status}</span>`;
        }

        feedback.textContent = '✅ Status berhasil diubah ke "' + status + '"';
        feedback.className = 'text-sm mt-2 text-emerald-600 font-medium';
        feedback.classList.remove('hidden');

        setTimeout(() => feedback.classList.add('hidden'), 3000);
      } catch (err) {
        feedback.textContent = '❌ Gagal: ' + err.message;
        feedback.className = 'text-sm mt-2 text-red-500';
        feedback.classList.remove('hidden');
      } finally {
        btn.disabled = false;
        btn.textContent = 'Simpan';
      }
    }
  </script>
  <% } %>
</body>
</html>
