<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Pesanan Saya — <%= storeName %></title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>body { font-family: 'Inter', sans-serif; }</style>
</head>
<body class="bg-gray-50 min-h-screen">
  <%- include('partials/nav', { storeName, active: 'invoice' }) %>
  <%- include('partials/status-helper') %>

  <main class="max-w-4xl mx-auto px-4 pb-10">
    <div class="flex items-center justify-between mb-6">
      <div>
        <h2 class="text-xl font-bold text-gray-800">
          <%= (typeof user !== 'undefined' && user && user.role === 'admin') ? 'Semua Pesanan' : 'Pesanan Saya' %>
        </h2>
        <p class="text-sm text-gray-400 mt-0.5"><%= orders.length %> pesanan</p>
      </div>
    </div>

    <% if (orders.length === 0) { %>
      <div class="text-center py-20">
        <div class="text-5xl mb-4">📦</div>
        <p class="text-gray-400 text-lg">Belum ada pesanan</p>
        <a href="/" class="inline-block mt-4 text-blue-500 hover:text-blue-600 font-medium text-sm">← Mulai belanja</a>
      </div>
    <% } %>

    <div class="space-y-4">
      <% orders.forEach(function(order) { %>
        <div class="bg-white border border-gray-200 rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition-shadow">
          <div class="px-5 py-4 flex items-center justify-between border-b border-gray-100">
            <div class="flex items-center gap-3">
              <span class="text-base font-bold text-gray-800">INV-<%= String(order.id).padStart(5, '0') %></span>
              <%- include('partials/badge', { label: order.status, color: getStatusColor(order.status) }) %>
            </div>
            <span class="text-xs text-gray-400">
              <%= new Date(order.createdAt).toLocaleString('id-ID', { dateStyle: 'medium', timeStyle: 'short' }) %>
            </span>
          </div>

          <div class="px-5 py-3">
            <% if (order.OrderItems && order.OrderItems.length > 0) { %>
              <% order.OrderItems.forEach(function(item) { %>
                <div class="flex items-center justify-between py-2 border-b border-gray-50 last:border-0">
                  <div>
                    <p class="font-medium text-gray-700 text-sm"><%= item.Product ? item.Product.name : '(produk dihapus)' %></p>
                    <p class="text-xs text-gray-400"><%= item.quantity %> × Rp<%= item.price.toLocaleString('id-ID') %></p>
                  </div>
                  <p class="font-semibold text-gray-600 text-sm">Rp<%= (item.price * item.quantity).toLocaleString('id-ID') %></p>
                </div>
              <% }); %>
            <% } %>
          </div>

          <div class="px-5 py-3 bg-gray-50/50 flex items-center justify-between">
            <p class="text-sm text-gray-500"><strong>Pembeli:</strong> <%= order.buyerName %></p>
            <div class="flex items-center gap-4">
              <p class="font-bold text-gray-800">
                Total: <span class="bg-gradient-to-r from-blue-600 to-purple-600 bg-clip-text text-transparent">Rp<%= order.totalAmount.toLocaleString('id-ID') %></span>
              </p>
              <a href="/invoices/<%= order.id %>"
                class="text-sm text-blue-500 hover:text-blue-700 font-medium transition-colors flex items-center gap-1">
                Detail →
              </a>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  </main>
</body>
</html>
