<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Admin Dashboard — <%= storeName %></title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>body { font-family: 'Inter', sans-serif; }</style>
</head>
<body class="bg-gray-50 min-h-screen">
  <%- include('../partials/nav', { storeName, active: 'dashboard' }) %>

  <main class="max-w-6xl mx-auto px-4 pb-10">
    <div class="mb-8">
      <h2 class="text-2xl font-bold text-gray-800">Dashboard Admin</h2>
      <p class="text-gray-400 text-sm mt-1">Overview statistik toko</p>
    </div>

    <!-- Stats Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 mb-8">
      <div class="bg-white rounded-2xl border border-gray-200 p-6 shadow-sm hover:shadow-md transition-shadow">
        <div class="flex items-center gap-4">
          <div class="w-14 h-14 bg-gradient-to-br from-blue-500 to-blue-600 rounded-2xl flex items-center justify-center shadow-lg shadow-blue-500/25">
            <span class="text-2xl">📦</span>
          </div>
          <div>
            <p class="text-sm text-gray-400 font-medium">Total Produk</p>
            <p class="text-3xl font-extrabold text-gray-800"><%= stats.totalProducts %></p>
          </div>
        </div>
      </div>

      <div class="bg-white rounded-2xl border border-gray-200 p-6 shadow-sm hover:shadow-md transition-shadow">
        <div class="flex items-center gap-4">
          <div class="w-14 h-14 bg-gradient-to-br from-purple-500 to-purple-600 rounded-2xl flex items-center justify-center shadow-lg shadow-purple-500/25">
            <span class="text-2xl">🛍️</span>
          </div>
          <div>
            <p class="text-sm text-gray-400 font-medium">Total Pesanan</p>
            <p class="text-3xl font-extrabold text-gray-800"><%= stats.totalOrders %></p>
          </div>
        </div>
      </div>

      <div class="bg-white rounded-2xl border border-gray-200 p-6 shadow-sm hover:shadow-md transition-shadow">
        <div class="flex items-center gap-4">
          <div class="w-14 h-14 bg-gradient-to-br from-emerald-500 to-emerald-600 rounded-2xl flex items-center justify-center shadow-lg shadow-emerald-500/25">
            <span class="text-2xl">💰</span>
          </div>
          <div>
            <p class="text-sm text-gray-400 font-medium">Total Revenue</p>
            <p class="text-2xl font-extrabold text-gray-800">Rp<%= stats.totalRevenue.toLocaleString('id-ID') %></p>
          </div>
        </div>
      </div>
    </div>

    <!-- Quick Links -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <a href="/admin/products"
        class="group bg-white rounded-2xl border border-gray-200 p-6 shadow-sm hover:shadow-md hover:border-blue-200 transition-all flex items-center justify-between">
        <div>
          <h3 class="font-bold text-gray-800 text-lg group-hover:text-blue-600 transition-colors">Kelola Produk</h3>
          <p class="text-sm text-gray-400 mt-1">Tambah, edit, atau hapus produk</p>
        </div>
        <span class="text-3xl group-hover:translate-x-1 transition-transform">→</span>
      </a>

      <a href="/admin/invoices"
        class="group bg-white rounded-2xl border border-gray-200 p-6 shadow-sm hover:shadow-md hover:border-purple-200 transition-all flex items-center justify-between">
        <div>
          <h3 class="font-bold text-gray-800 text-lg group-hover:text-purple-600 transition-colors">Kelola Invoice</h3>
          <p class="text-sm text-gray-400 mt-1">Lihat detail & ubah status pesanan</p>
        </div>
        <span class="text-3xl group-hover:translate-x-1 transition-transform">→</span>
      </a>
    </div>
  </main>
</body>
</html>
