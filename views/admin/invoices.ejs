<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Kelola Invoice — <%= storeName %></title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>body { font-family: 'Inter', sans-serif; }</style>
</head>
<body class="bg-gray-50 min-h-screen">
  <%- include('../partials/nav', { storeName, active: 'admin-invoices' }) %>
  <%- include('../partials/status-helper') %>

  <main class="max-w-6xl mx-auto px-4 pb-10">
    <div class="flex items-center justify-between mb-6">
      <div>
        <h2 class="text-xl font-bold text-gray-800">Kelola Invoice</h2>
        <p class="text-sm text-gray-400 mt-0.5"><%= orders.length %> pesanan</p>
      </div>
      <!-- Filter -->
      <select id="status-filter" onchange="filterByStatus()"
        class="px-4 py-2.5 border border-gray-200 rounded-xl text-sm bg-white text-gray-600 font-medium focus:outline-none focus:ring-2 focus:ring-blue-400/50">
        <option value="">Semua Status</option>
        <option value="pending">Pending</option>
        <option value="diproses">Diproses</option>
        <option value="dikirim">Dikirim</option>
        <option value="selesai">Selesai</option>
        <option value="dibatalkan">Dibatalkan</option>
      </select>
    </div>

    <% if (orders.length === 0) { %>
      <div class="text-center py-20">
        <div class="text-5xl mb-4">📋</div>
        <p class="text-gray-400 text-lg">Belum ada pesanan</p>
      </div>
    <% } %>

    <div class="space-y-4" id="orders-list">
      <% orders.forEach(function(order) { %>
        <div class="order-card bg-white border border-gray-200 rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition-shadow" data-status="<%= order.status %>">
          <div class="px-5 py-4 flex flex-col sm:flex-row sm:items-center justify-between border-b border-gray-100 gap-3">
            <div class="flex items-center gap-3">
              <span class="text-base font-bold text-gray-800">INV-<%= String(order.id).padStart(5, '0') %></span>
              <span id="badge-<%= order.id %>">
                <%- include('../partials/badge', { label: order.status, color: getStatusColor(order.status) }) %>
              </span>
            </div>
            <div class="flex items-center gap-3">
              <select
                id="status-<%= order.id %>"
                class="px-3 py-1.5 border border-gray-200 rounded-lg text-sm bg-white focus:outline-none focus:ring-2 focus:ring-blue-400/50"
                onchange="updateStatus(<%= order.id %>, this.value)">
                <option value="pending" <%= order.status === 'pending' ? 'selected' : '' %>>Pending</option>
                <option value="diproses" <%= order.status === 'diproses' ? 'selected' : '' %>>Diproses</option>
                <option value="dikirim" <%= order.status === 'dikirim' ? 'selected' : '' %>>Dikirim</option>
                <option value="selesai" <%= order.status === 'selesai' ? 'selected' : '' %>>Selesai</option>
                <option value="dibatalkan" <%= order.status === 'dibatalkan' ? 'selected' : '' %>>Dibatalkan</option>
              </select>
              <span class="text-xs text-gray-400">
                <%= new Date(order.createdAt).toLocaleString('id-ID', { dateStyle: 'medium', timeStyle: 'short' }) %>
              </span>
            </div>
          </div>

          <div class="px-5 py-3">
            <% if (order.OrderItems && order.OrderItems.length > 0) { %>
              <% order.OrderItems.forEach(function(item) { %>
                <div class="flex items-center justify-between py-2 border-b border-gray-50 last:border-0">
                  <div>
                    <p class="font-medium text-gray-700 text-sm"><%= item.Product ? item.Product.name : '(dihapus)' %></p>
                    <p class="text-xs text-gray-400"><%= item.quantity %> × Rp<%= item.price.toLocaleString('id-ID') %></p>
                  </div>
                  <p class="font-semibold text-gray-600 text-sm">Rp<%= (item.price * item.quantity).toLocaleString('id-ID') %></p>
                </div>
              <% }); %>
            <% } %>
          </div>

          <div class="px-5 py-3 bg-gray-50/50 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-2">
            <div class="text-sm text-gray-500">
              <strong>Pembeli:</strong> <%= order.buyerName %>
              <% if (order.User) { %>
                <span class="text-gray-400 ml-1">(@<%= order.User.username %>)</span>
              <% } %>
            </div>
            <p class="font-bold text-gray-800">
              Total: <span class="bg-gradient-to-r from-blue-600 to-purple-600 bg-clip-text text-transparent">Rp<%= order.totalAmount.toLocaleString('id-ID') %></span>
            </p>
          </div>
        </div>
      <% }) %>
    </div>
  </main>

  <script>
    const statusColorMap = {
      pending: 'yellow',
      diproses: 'blue',
      dikirim: 'purple',
      selesai: 'green',
      dibatalkan: 'red',
    };

    async function updateStatus(orderId, status) {
      try {
        const res = await fetch(`/api/orders/${orderId}/status`, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ status }),
        });

        const result = await res.json();

        if (!result.success) {
          alert(result.message);
          return;
        }

        // Update badge inline tanpa reload
        const badgeEl = document.getElementById(`badge-${orderId}`);
        const color = statusColorMap[status] || 'gray';
        const colorClasses = {
          green: 'bg-emerald-100 text-emerald-700 border-emerald-300',
          red: 'bg-red-100 text-red-700 border-red-300',
          yellow: 'bg-amber-100 text-amber-700 border-amber-300',
          blue: 'bg-blue-100 text-blue-700 border-blue-300',
          purple: 'bg-purple-100 text-purple-700 border-purple-300',
          gray: 'bg-gray-100 text-gray-700 border-gray-300',
        };
        badgeEl.innerHTML = `<span class="inline-block px-2.5 py-1 text-xs font-bold rounded-full border ${colorClasses[color]}">${status}</span>`;

        // Update card data-status for filtering
        const card = badgeEl.closest('.order-card');
        card.dataset.status = status;

        // Flash effect
        card.style.transition = 'box-shadow 0.3s ease';
        card.style.boxShadow = '0 0 0 2px rgba(99,102,241,0.5)';
        setTimeout(() => { card.style.boxShadow = ''; }, 1000);
      } catch (err) {
        alert('Gagal update status: ' + err.message);
      }
    }

    function filterByStatus() {
      const status = document.getElementById('status-filter').value;
      const cards = document.querySelectorAll('.order-card');
      cards.forEach(card => {
        card.style.display = (!status || card.dataset.status === status) ? '' : 'none';
      });
    }
  </script>
</body>
</html>
